# Live routing remains off until explicitly enabled in the deployment environment.
LIVE_TRADING_ENABLED=false

# Existing internal Coinbase execution service. Do not put exchange keys here.
COINBASE_EXECUTOR_URL=http://127.0.0.1:8088/v1/orders

# Runtime paths.
CYBERCORE_DATA_DIR=./data
CYBERCORE_LOG_DIR=./logs
CYBERCORE_POLICY_PATH=./config/risk-policy.json

# Denver is the morning-brief control timezone.
CYBERCORE_TIMEZONE=America/Denver

# Loop interval.
CONTROLLER_INTERVAL_SECONDS=20


# Required child hedge after every accepted primary fill.
AUTOHEDGE_ENABLED=true

# Independent order-state verifier. Must contain {order_id}.
COINBASE_ORDER_STATUS_URL_TEMPLATE=http://127.0.0.1:8088/v1/orders/{order_id}
HEDGE_VERIFICATION_TIMEOUT_SECONDS=15
